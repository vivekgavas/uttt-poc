# =============================================================================
# .env.example — copy this file to .env and fill in your values
#
# HOW TO USE:
#   cp .env.example .env
#   nano .env          # edit the values
#   chmod 600 .env     # restrict read access to your user only
#
# IMPORTANT: .env is excluded from Git (.gitignore). Never commit it.
#            This file (.env.example) IS committed — it has no real secrets.
#
# The app reads these with python-decouple, which automatically loads .env
# from the project root. You do NOT need to "source" or "export" anything.
# =============================================================================

# --- Django core ---

# A long, random secret string used for cryptographic signing.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-this-with-a-long-random-string

# Set to True for local development only. Never True in production.
DEBUG=True

# Comma-separated list of hostnames/IPs Django will accept requests for.
# For local VirtualBox testing via NAT, keep this as shown.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL database ---

# The database name you created in PostgreSQL.
DB_NAME=uttt

# The PostgreSQL username.
DB_USER=pg

# The PostgreSQL password for that user.
# Set this to the actual password — never commit the real value.
DB_PASSWORD=replace-with-your-postgres-password

# Host and port for the database connection from Linux.
# Leave these as-is unless your setup differs.
DB_HOST=127.0.0.1
DB_PORT=5432
