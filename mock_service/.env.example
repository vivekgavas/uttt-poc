# ============================================================
# Mock External Service — environment variables
# Copy this file to mock_service/.env and fill in the values.
# ============================================================

# Django secret key (generate a fresh one for any non-dev environment)
MOCK_SECRET_KEY=change-me-mock-secret-key

# Set to False in production
DEBUG=True

# Hosts Django is allowed to serve (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------

# API key the UTTT worker must include in X-Api-Key when calling this service.
# Must match PRODUCT_DEMO_API_KEY in the main UTTT .env.
MOCK_API_KEY=demo-api-key-change-me

# API key this service sends in X-Callback-Api-Key when posting callbacks to UTTT.
# Must match PRODUCT_DEMO_CALLBACK_SECRET in the main UTTT .env.
UTTT_CALLBACK_API_KEY=demo-callback-secret-change-me

# ----------------------------------------------------------
# Allowed callback targets
# ----------------------------------------------------------

# Comma-separated list of UTTT base URLs this service is allowed to callback.
# Prevents the service from being used to send HTTP requests to arbitrary hosts.
ALLOWED_CALLBACK_URLS=http://127.0.0.1:8000

# ----------------------------------------------------------
# Test case behaviour
# ----------------------------------------------------------

# How long (seconds) TC002 takes to complete after starting
TC002_DELAY_SECONDS=3.0

# ----------------------------------------------------------
# Worker
# ----------------------------------------------------------

# How often the mock worker polls for pending work (seconds)
MOCK_WORKER_POLL_INTERVAL_SECONDS=2

# Maximum number of delivery attempts for each outbound callback
CALLBACK_MAX_RETRIES=5

# HTTP timeout for outbound callback calls (seconds)
CALLBACK_HTTP_TIMEOUT_SECONDS=10
